#!/bin/bash
# A script which parses through sitemap and dumps all urls in the sitemap
# The urls in a file called urls.txt in the tmp/sites directory 

function waitForJobs() {
  local pid
  local status=0
  for pid in "$@"; do
    wait "$pid" || status=1
  done
  return "$status"
}

function cleanupRunDir() {
  if [ -n "$runDir" ] && [ -d "$runDir" ]; then
    find "$runDir" -depth -delete
  fi
}

function publishSnapshots() {
  local stagedDir
  local domain
  local target

  for stagedDir in "$runDir"/*; do
    [ -d "$stagedDir" ] || continue
    domain="${stagedDir##*/}"
    target="/tmp/site/$domain"

    if [ -e "$target" ]; then
      find "$target" -depth -delete || return 1
    fi
    mv "$stagedDir" "$target" || return 1
  done
}

function requireCommands() {
  local dependency

  for dependency in curl gzip od xsltproc; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
      echo "Missing required command: $dependency" >&2
      return 1
    fi
  done
}

function writeStylesheet() {
  local stylesheetFile="$1"

  cat > "$stylesheetFile" <<'XSL'
<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="text" encoding="UTF-8"/>
  <xsl:strip-space elements="*"/>
  <xsl:template match="/">
    <xsl:choose>
      <xsl:when test="local-name(/*) = 'sitemapindex'">
        <xsl:text>sitemapindex&#10;</xsl:text>
        <xsl:for-each select="/*[local-name() = 'sitemapindex']/*[local-name() = 'sitemap']/*[local-name() = 'loc']">
          <xsl:value-of select="normalize-space(.)"/>
          <xsl:text>&#10;</xsl:text>
        </xsl:for-each>
      </xsl:when>
      <xsl:when test="local-name(/*) = 'urlset'">
        <xsl:text>urlset&#10;</xsl:text>
        <xsl:for-each select="/*[local-name() = 'urlset']/*[local-name() = 'url']/*[local-name() = 'loc']">
          <xsl:value-of select="normalize-space(.)"/>
          <xsl:text>&#10;</xsl:text>
        </xsl:for-each>
      </xsl:when>
      <xsl:otherwise>
        <xsl:message terminate="yes">Unsupported sitemap root</xsl:message>
      </xsl:otherwise>
    </xsl:choose>
  </xsl:template>
</xsl:stylesheet>
XSL
}

function getUrlDir() {
  local url="$1"
  local authority
  local dir

  case "$url" in
    http://*) authority="${url#http://}" ;;
    https://*) authority="${url#https://}" ;;
    *)
      echo "Unsupported URL scheme: $url" >&2
      return 1
      ;;
  esac

  authority="${authority%%[/?#]*}"
  case "$authority" in
    *"@"*)
      echo "URL credentials are not supported: $url" >&2
      return 1
      ;;
  esac

  dir="${authority#www.}"
  case "$dir" in
    ""|"."|".."|*/*|*[[:space:]]*)
      echo "Invalid output domain for URL: $url" >&2
      return 1
      ;;
  esac
  printf "%s\n" "$dir"
}

function writePageUrl() {
  local url="$1"
  local dir
  local outputDir

  dir="$(getUrlDir "$url")" || return 1
  outputDir="$runDir/$dir"
  mkdir -p "$outputDir" || return 1
  printf "%s\n" "$url" >> "$outputDir/urls.txt"
}

function mergeResultFile() {
  local resultFile="$1"
  local documentType
  local lineNumber=0
  local url

  IFS= read -r documentType < "$resultFile" || return 1
  case "$documentType" in
    sitemapindex|urlset) ;;
    *) return 1 ;;
  esac

  while IFS= read -r url; do
    lineNumber=$((lineNumber + 1))
    [ "$lineNumber" -eq 1 ] && continue
    [ -z "$url" ] && continue

    if [ "$documentType" = "sitemapindex" ]; then
      queue+=("$url")
    else
      writePageUrl "$url" || return 1
    fi
  done < "$resultFile"
}


# Fetch a sitemap and write its document type and locations to a result file.
function processSitemap() {
   local url="$1"
   local resultFile="$2"
   local stylesheetFile="$3"
   local dir
   local outputDir
   local file
   local tempFile
   local decompressedFile
   local fileHeader
   local documentType

   dir="$(getUrlDir "$url")" || return 1
   outputDir="$runDir/$dir"

   file="$(printf "%s" "$url" | cksum | tr " " "-").xml"
   mkdir -p "$outputDir" || return 1
   tempFile="$(mktemp "$outputDir/.sitemap.XXXXXX")" || return 1
   echo "Fetching URLs from site-map: $url"
   curl -fsSL "$url" > "$tempFile" || return 1

   fileHeader="$(LC_ALL=C od -An -t x1 -N 4 "$tempFile")" || return 1
   fileHeader="${fileHeader//[[:space:]]/}"
   if [ "${fileHeader#1f8b}" != "$fileHeader" ]; then
     decompressedFile="$(mktemp "$outputDir/.sitemap.XXXXXX")" || return 1
     if ! gzip -dc "$tempFile" > "$decompressedFile"; then
       echo "Unable to decompress sitemap: $url" >&2
       return 1
     fi
     mv "$decompressedFile" "$tempFile" || return 1
     fileHeader="$(LC_ALL=C od -An -t x1 -N 4 "$tempFile")" || return 1
     fileHeader="${fileHeader//[[:space:]]/}"
   fi

   case "$fileHeader" in
     fffe*|feff*|0000feff*|fffe0000*|003c003f*|3c003f00*|0000003c*|3c000000*|00003c00*|003c0000*)
       echo "Unsupported sitemap encoding: $url" >&2
       return 1
       ;;
   esac

   if LC_ALL=C grep -q '<!DOCTYPE' "$tempFile"; then
     echo "Sitemap DOCTYPE is not supported: $url" >&2
     return 1
   fi

   if ! xsltproc --nonet "$stylesheetFile" "$tempFile" > "$resultFile"; then
     echo "Unsupported sitemap document: $url" >&2
     return 1
   fi

   IFS= read -r documentType < "$resultFile" || return 1
   case "$documentType" in
     sitemapindex|urlset) ;;
     *)
       echo "Unsupported sitemap document: $url" >&2
       return 1
       ;;
   esac
   mv "$tempFile" "$outputDir/$file" || return 1
}


if ! requireCommands; then
  exit 1
fi

if ! cd /tmp/ || ! mkdir -p site || ! cd site; then
  echo "Unable to prepare /tmp/site" >&2
  exit 1
fi

runDir="$(mktemp -d /tmp/sitescrape.XXXXXX)" || {
  echo "Unable to prepare a temporary output directory" >&2
  exit 1
}
seenFile="$runDir/.seen-sitemaps"
stylesheetFile="$runDir/.sitemap-locations.xsl"
trap cleanupRunDir EXIT
if ! writeStylesheet "$stylesheetFile"; then
  echo "Unable to prepare the sitemap parser" >&2
  exit 1
fi

if [ "$#" -eq 0 ]; then
  echo "Pass a Site Map URL" >&2
  exit 1
else
  queue=("$@")
  queueIndex=0
  maxJobs=5
  while [ "$queueIndex" -lt "${#queue[@]}" ]; do
    pids=()
    resultFiles=()
    batchSize=0
    setupFailed=0

    while [ "$queueIndex" -lt "${#queue[@]}" ] && [ "$batchSize" -lt "$maxJobs" ]; do
      url="${queue[$queueIndex]}"
      queueIndex=$((queueIndex + 1))

      if grep -Fqx "$url" "$seenFile" 2>/dev/null; then
        continue
      fi
      if ! printf "%s\n" "$url" >> "$seenFile"; then
        setupFailed=1
        break
      fi
      if ! resultFile="$(mktemp "$runDir/.urls.XXXXXX")"; then
        setupFailed=1
        break
      fi
      processSitemap "$url" "$resultFile" "$stylesheetFile" &
      pids+=("$!")
      resultFiles+=("$resultFile")
      batchSize=$((batchSize + 1))
    done

    batchFailed="$setupFailed"
    waitForJobs "${pids[@]}" || batchFailed=1
    if [ "$batchFailed" -ne 0 ]; then
      echo "Site scrape failed" >&2
      exit 1
    fi
    for resultFile in "${resultFiles[@]}"; do
      if ! mergeResultFile "$resultFile"; then
        echo "Unable to process sitemap results" >&2
        exit 1
      fi
      find "$resultFile" -delete || exit 1
    done
  done
  if ! publishSnapshots; then
    echo "Unable to replace previous site results" >&2
    exit 1
  fi
  echo "Site Scraped!!"
fi

